# ============================================================================
# VĂN HỌCVERSE – ENVIRONMENT VARIABLES (.env.example)
# ============================================================================
# Copy file này thành .env khi chạy local hoặc khai báo trên Vercel Dashboard
# (Project Settings -> Environment Variables).
# Tuyệt đối KHÔNG commit khóa bí mật thật vào GitHub.

# (Tùy chọn) URL chính thức của website trên Vercel
VITE_APP_URL="https://vanhocverse.vercel.app"

# (Tùy chọn) Cấu hình Supabase nếu mở rộng lưu trữ đám mây trong tương lai
# VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY=""
